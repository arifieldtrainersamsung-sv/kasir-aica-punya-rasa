<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AICA PUNYA RASA - Kasir Pop Art</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #FFFBEB;
        }
        .pop-font {
            font-family: 'Fredoka', cursive;
        }
        .pop-card {
            border: 3px solid #1E293B;
            box-shadow: 5px 5px 0px #1E293B;
            transition: all 0.15s ease-in-out;
        }
        .pop-card:hover {
            transform: translate(-2px, -2px);
            box-shadow: 7px 7px 0px #1E293B;
        }
        .pop-btn {
            border: 3px solid #1E293B;
            box-shadow: 4px 4px 0px #1E293B;
            font-weight: 700;
            transition: all 0.1s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .pop-btn:active {
            transform: translate(3px, 3px);
            box-shadow: 1px 1px 0px #1E293B;
        }
        .pop-badge {
            border: 2px solid #1E293B;
            box-shadow: 2px 2px 0px #1E293B;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #FEF08A;
            border: 2px solid #1E293B;
        }
        ::-webkit-scrollbar-thumb {
            background: #FF007A;
            border: 2px solid #1E293B;
        }

        /* Printable Receipt Styles */
        @media print {
            body * {
                visibility: hidden;
            }
            #printable-receipt, #printable-receipt * {
                visibility: visible;
            }
            #printable-receipt {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                margin: 0;
                padding: 15px;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body class="h-screen flex flex-col overflow-hidden">

    <!-- TOP NAVBAR -->
    <header class="bg-[#FFD700] border-b-4 border-slate-900 px-6 py-3 flex justify-between items-center z-20">
        <div class="flex items-center gap-3">
            <div class="bg-[#FF007A] text-white p-2 rounded-xl border-2 border-slate-900 pop-badge flex items-center justify-center">
                <i data-lucide="utensils-crossed" class="w-7 h-7 stroke-[3]"></i>
            </div>
            <div>
                <h1 class="pop-font text-2xl md:text-3xl font-extrabold text-slate-900 tracking-wider leading-none">
                    AICA <span class="text-[#FF007A] bg-white px-2 py-0.5 rounded-lg border-2 border-slate-900 inline-block rotate-1">PUNYA RASA</span>
                </h1>
                <p class="text-xs font-bold text-slate-800 tracking-wide mt-1">Catering Makan Rumahan Lezat & Hygienis</p>
            </div>
        </div>

        <!-- Navigation Tabs -->
        <nav class="flex gap-2">
            <button onclick="switchTab('pos')" id="tab-pos" class="pop-btn bg-[#00E5FF] text-slate-900 px-4 py-2 rounded-xl flex items-center gap-2 text-sm md:text-base">
                <i data-lucide="shopping-bag" class="w-5 h-5"></i>
                <span class="hidden md:inline">Kasir (POS)</span>
            </button>
            <button onclick="switchTab('menu')" id="tab-menu" class="pop-btn bg-white text-slate-900 px-4 py-2 rounded-xl flex items-center gap-2 text-sm md:text-base">
                <i data-lucide="utensils" class="w-5 h-5"></i>
                <span class="hidden md:inline">Kelola Menu</span>
            </button>
            <button onclick="switchTab('maintenance')" id="tab-maintenance" class="pop-btn bg-white text-slate-900 px-4 py-2 rounded-xl flex items-center gap-2 text-sm md:text-base">
                <i data-lucide="wrench" class="w-5 h-5"></i>
                <span class="hidden md:inline">Maintenance</span>
            </button>
        </nav>
    </header>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="flex-1 overflow-hidden relative">

        <!-- ================= SECTION 1: KASIR (POS) ================= -->
        <div id="section-pos" class="h-full grid grid-cols-1 lg:grid-cols-12 gap-4 p-4 md:p-6 overflow-hidden">
            
            <!-- LEFT SIDE: MENU CATALOG (8 Cols) -->
            <div class="lg:col-span-7 xl:col-span-8 flex flex-col h-full gap-4 overflow-hidden">
                <!-- Search & Filter Bar -->
                <div class="bg-[#7C3AED] p-4 rounded-2xl border-4 border-slate-900 pop-card flex flex-col md:flex-row gap-3 items-center justify-between">
                    <div class="relative w-full md:w-72">
                        <i data-lucide="search" class="absolute left-3 top-1/2 transform -translate-y-1/2 text-slate-800 w-5 h-5"></i>
                        <input type="text" id="search-input" oninput="renderMenuList()" placeholder="Cari menu catering..." 
                            class="w-full pl-10 pr-4 py-2 rounded-xl border-3 border-slate-900 text-slate-900 font-semibold focus:outline-none focus:ring-4 focus:ring-[#FFD700]">
                    </div>
                    
                    <!-- Categories -->
                    <div class="flex gap-2 overflow-x-auto w-full md:w-auto pb-1 md:pb-0" id="category-filters">
                        <!-- Categories injected dynamically -->
                    </div>
                </div>

                <!-- Menu Cards Grid -->
                <div id="menu-grid" class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4 overflow-y-auto pr-1 flex-1 pb-12">
                    <!-- Menu Cards dynamically inserted -->
                </div>
            </div>

            <!-- RIGHT SIDE: ORDER CART (4 Cols) -->
            <div class="lg:col-span-5 xl:col-span-4 bg-white rounded-2xl border-4 border-slate-900 pop-card flex flex-col h-full overflow-hidden">
                
                <!-- Cart Header -->
                <div class="bg-[#FF007A] p-4 border-b-4 border-slate-900 text-white flex justify-between items-center">
                    <div class="flex items-center gap-2">
                        <i data-lucide="receipt" class="w-6 h-6 stroke-[3]"></i>
                        <h2 class="pop-font text-xl font-bold tracking-wide">Keranjang Pesanan</h2>
                    </div>
                    <button onclick="clearCart()" class="bg-[#FFD700] text-slate-900 hover:bg-yellow-300 p-1.5 rounded-lg border-2 border-slate-900 pop-badge font-bold text-xs flex items-center gap-1">
                        <i data-lucide="trash-2" class="w-4 h-4"></i> Reset
                    </button>
                </div>

                <!-- Customer Details Input -->
                <div class="p-3 bg-slate-50 border-b-2 border-slate-900 grid grid-cols-2 gap-2 text-xs">
                    <div>
                        <label class="font-bold text-slate-700 block mb-1">Nama Pemesan:</label>
                        <input type="text" id="customer-name" value="Pelanggan Umum" class="w-full px-2 py-1 rounded-lg border-2 border-slate-900 font-semibold focus:outline-none">
                    </div>
                    <div>
                        <label class="font-bold text-slate-700 block mb-1">Jenis Layanan:</label>
                        <select id="order-type" class="w-full px-2 py-1 rounded-lg border-2 border-slate-900 font-semibold focus:outline-none bg-white">
                            <option value="Catering Harian">Catering Harian</option>
                            <option value="Prasmanan / Acara">Prasmanan / Acara</option>
                            <option value="Takeaway / Bungkusan">Takeaway / Bungkusan</option>
                        </select>
                    </div>
                </div>

                <!-- Cart Items List -->
                <div id="cart-items" class="flex-1 overflow-y-auto p-4 space-y-3">
                    <!-- Cart items generated here -->
                </div>

                <!-- Calculation Summary & Payment Trigger -->
                <div class="p-4 bg-amber-50 border-t-4 border-slate-900 space-y-2">
                    <div class="flex justify-between text-slate-700 font-bold text-sm">
                        <span>Subtotal:</span>
                        <span id="cart-subtotal">Rp 0</span>
                    </div>
                    <div class="flex justify-between text-slate-700 font-bold text-sm">
                        <span>Pajak (0%):</span>
                        <span id="cart-tax">Rp 0</span>
                    </div>
                    <div class="flex justify-between text-slate-900 font-black text-lg pt-2 border-t-2 border-dashed border-slate-900">
                        <span>TOTAL:</span>
                        <span id="cart-total" class="text-[#FF007A]">Rp 0</span>
                    </div>

                    <button onclick="openPaymentModal()" id="btn-pay" disabled 
                        class="w-full mt-3 pop-btn bg-[#10B981] disabled:bg-slate-300 disabled:text-slate-500 disabled:border-slate-400 text-white py-3 rounded-xl font-extrabold text-lg flex justify-center items-center gap-2">
                        <i data-lucide="credit-card" class="w-6 h-6"></i> Bayar Sekarang
                    </button>
                </div>
            </div>
        </div>

        <!-- ================= SECTION 2: EDIT & KELOLA MENU ================= -->
        <div id="section-menu" class="h-full p-4 md:p-6 overflow-y-auto hidden">
            <div class="max-w-6xl mx-auto space-y-6">
                
                <!-- Menu Management Header -->
                <div class="bg-[#00E5FF] p-6 rounded-2xl border-4 border-slate-900 pop-card flex flex-col md:flex-row justify-between items-center gap-4">
                    <div>
                        <h2 class="pop-font text-3xl font-extrabold text-slate-900">Kelola Menu Catering</h2>
                        <p class="font-bold text-slate-800">Tambah, ubah harga, atau update stok menu catering anda.</p>
                    </div>
                    <button onclick="openAddMenuModal()" class="pop-btn bg-[#FF007A] text-white px-5 py-3 rounded-xl flex items-center gap-2 text-base">
                        <i data-lucide="plus-circle" class="w-6 h-6"></i> Tambah Menu Baru
                    </button>
                </div>

                <!-- Table of Menus -->
                <div class="bg-white rounded-2xl border-4 border-slate-900 pop-card overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-[#FFD700] border-b-4 border-slate-900 text-slate-900 font-black text-sm uppercase">
                                    <th class="p-4">Foto</th>
                                    <th class="p-4">Nama Menu</th>
                                    <th class="p-4">Kategori</th>
                                    <th class="p-4">Harga</th>
                                    <th class="p-4">Stok</th>
                                    <th class="p-4 text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="menu-table-body" class="divide-y-2 divide-slate-900 font-semibold text-slate-800">
                                <!-- Dynamic rows -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================= SECTION 3: MAINTENANCE & SYSTEM ================= -->
        <div id="section-maintenance" class="h-full p-4 md:p-6 overflow-y-auto hidden">
            <div class="max-w-5xl mx-auto space-y-6">
                
                <div class="bg-[#FF007A] p-6 rounded-2xl border-4 border-slate-900 pop-card text-white flex justify-between items-center">
                    <div>
                        <h2 class="pop-font text-3xl font-extrabold">Maintenance & Analytics</h2>
                        <p class="font-semibold text-pink-100">Pusat kendali performa aplikasi dan data transaksi.</p>
                    </div>
                    <div class="bg-white text-slate-900 p-3 rounded-xl border-2 border-slate-900 font-bold text-center">
                        <div class="text-xs text-slate-500">Status Sistem</div>
                        <div class="text-emerald-600 font-extrabold flex items-center gap-1">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span> ONLINE
                        </div>
                    </div>
                </div>

                <!-- Stats Overview -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="bg-[#FFD700] p-5 rounded-xl border-4 border-slate-900 pop-card">
                        <div class="text-slate-800 font-bold text-sm">Total Transaksi</div>
                        <div id="stat-total-tx" class="pop-font text-3xl font-black text-slate-900 mt-1">0</div>
                    </div>
                    <div class="bg-[#00E5FF] p-5 rounded-xl border-4 border-slate-900 pop-card">
                        <div class="text-slate-800 font-bold text-sm">Total Pendapatan</div>
                        <div id="stat-total-rev" class="pop-font text-2xl font-black text-slate-900 mt-1">Rp 0</div>
                    </div>
                    <div class="bg-[#A7F3D0] p-5 rounded-xl border-4 border-slate-900 pop-card">
                        <div class="text-slate-800 font-bold text-sm">Total Item Terjual</div>
                        <div id="stat-total-items" class="pop-font text-3xl font-black text-slate-900 mt-1">0</div>
                    </div>
                </div>

                <!-- Tools & Utility Box -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Backup & Restore -->
                    <div class="bg-white p-6 rounded-2xl border-4 border-slate-900 pop-card space-y-4">
                        <h3 class="pop-font text-xl font-extrabold text-slate-900 flex items-center gap-2">
                            <i data-lucide="database" class="w-5 h-5 text-[#FF007A]"></i> Manajemen Data & Backup
                        </h3>
                        <p class="text-xs text-slate-600 font-medium">Cadangkan atau pulihkan data menu dan riwayat penjualan aplikasi anda secara offline.</p>
                        <div class="flex flex-wrap gap-3">
                            <button onclick="exportData()" class="pop-btn bg-[#7C3AED] text-white px-4 py-2 rounded-xl text-sm flex items-center gap-2">
                                <i data-lucide="download" class="w-4 h-4"></i> Ekspor Backup (JSON)
                            </button>
                            <label class="pop-btn bg-[#10B981] text-white px-4 py-2 rounded-xl text-sm flex items-center gap-2 cursor-pointer">
                                <i data-lucide="upload" class="w-4 h-4"></i> Impor Backup
                                <input type="file" id="import-file" onchange="importData(event)" class="hidden" accept=".json">
                            </label>
                        </div>
                    </div>

                    <!-- System Maintenance & Reset -->
                    <div class="bg-white p-6 rounded-2xl border-4 border-slate-900 pop-card space-y-4">
                        <h3 class="pop-font text-xl font-extrabold text-slate-900 flex items-center gap-2">
                            <i data-lucide="shield-alert" class="w-5 h-5 text-red-500"></i> Pemeliharaan Sistem
                        </h3>
                        <p class="text-xs text-slate-600 font-medium">Reset database jika terjadi kelambatan atau ingin memulai dari nol.</p>
                        <div class="flex flex-wrap gap-3">
                            <button onclick="resetDefaultMenu()" class="pop-btn bg-yellow-400 text-slate-900 px-4 py-2 rounded-xl text-sm flex items-center gap-2">
                                <i data-lucide="refresh-cw" class="w-4 h-4"></i> Reset Menu Bawaan
                            </button>
                            <button onclick="clearSalesHistory()" class="pop-btn bg-red-500 text-white px-4 py-2 rounded-xl text-sm flex items-center gap-2">
                                <i data-lucide="trash-2" class="w-4 h-4"></i> Hapus Riwayat Penjualan
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Sales History Table -->
                <div class="bg-white rounded-2xl border-4 border-slate-900 pop-card p-4 space-y-3">
                    <div class="flex justify-between items-center">
                        <h3 class="pop-font text-xl font-extrabold text-slate-900">Riwayat Transaksi Penjualan</h3>
                        <button onclick="exportSalesCSV()" class="pop-btn bg-[#00E5FF] text-slate-900 px-3 py-1.5 rounded-lg text-xs flex items-center gap-1">
                            <i data-lucide="file-spreadsheet" class="w-4 h-4"></i> Ekspor CSV
                        </button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs border-collapse">
                            <thead>
                                <tr class="bg-slate-100 border-b-2 border-slate-900 text-slate-800 font-bold">
                                    <th class="p-2">ID Transaksi</th>
                                    <th class="p-2">Waktu</th>
                                    <th class="p-2">Pelanggan</th>
                                    <th class="p-2">Pembayaran</th>
                                    <th class="p-2">Total</th>
                                </tr>
                            </thead>
                            <tbody id="sales-history-body" class="divide-y divide-slate-200">
                                <!-- Transaction rows dynamically populated -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

    </main>

    <!-- ================= MODAL 1: PEMBAYARAN ================= -->
    <div id="modal-payment" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl border-4 border-slate-900 pop-card w-full max-w-lg overflow-hidden flex flex-col max-h-[90vh]">
            
            <div class="bg-[#FFD700] p-4 border-b-4 border-slate-900 flex justify-between items-center">
                <h3 class="pop-font text-2xl font-black text-slate-900">Pembayaran Kasir</h3>
                <button onclick="closeModal('modal-payment')" class="text-slate-900 hover:text-red-600 font-black text-xl">✕</button>
            </div>

            <div class="p-5 space-y-4 overflow-y-auto flex-1">
                <div class="bg-pink-100 p-4 rounded-xl border-3 border-slate-900 text-center">
                    <span class="text-xs font-bold text-slate-600 uppercase tracking-wider block">Total Tagihan</span>
                    <span id="pay-total-amount" class="pop-font text-3xl font-black text-[#FF007A]">Rp 0</span>
                </div>

                <!-- Metode Pembayaran -->
                <div>
                    <label class="font-extrabold text-slate-800 block mb-2 text-sm">Metode Pembayaran:</label>
                    <div class="grid grid-cols-3 gap-2">
                        <button type="button" onclick="selectPayMethod('CASH')" id="pay-method-cash" class="pop-btn p-3 rounded-xl text-center bg-[#00E5FF] text-slate-900 text-sm font-bold flex flex-col items-center justify-center gap-1">
                            <i data-lucide="banknote" class="w-5 h-5"></i> Tunai (Cash)
                        </button>
                        <button type="button" onclick="selectPayMethod('QRIS')" id="pay-method-qris" class="pop-btn p-3 rounded-xl text-center bg-white text-slate-900 text-sm font-bold flex flex-col items-center justify-center gap-1">
                            <i data-lucide="qr-code" class="w-5 h-5"></i> QRIS
                        </button>
                        <button type="button" onclick="selectPayMethod('TRANSFER')" id="pay-method-transfer" class="pop-btn p-3 rounded-xl text-center bg-white text-slate-900 text-sm font-bold flex flex-col items-center justify-center gap-1">
                            <i data-lucide="building-2" class="w-5 h-5"></i> Transfer
                        </button>
                    </div>
                </div>

                <!-- Cash Section -->
                <div id="cash-payment-section" class="space-y-3">
                    <div>
                        <label class="font-extrabold text-slate-800 block mb-1 text-sm">Uang Diterima (Rp):</label>
                        <input type="number" id="cash-given-input" oninput="calculateChange()" placeholder="0" 
                            class="w-full p-3 rounded-xl border-3 border-slate-900 font-bold text-xl text-slate-900 focus:ring-4 focus:ring-[#FFD700] outline-none">
                    </div>

                    <!-- Quick Cash Buttons -->
                    <div class="grid grid-cols-4 gap-2" id="quick-cash-container">
                        <!-- Calculated dynamically -->
                    </div>

                    <div class="bg-amber-100 p-3 rounded-xl border-2 border-slate-900 flex justify-between items-center">
                        <span class="font-extrabold text-slate-800">Kembalian:</span>
                        <span id="cash-change-display" class="pop-font text-2xl font-black text-emerald-600">Rp 0</span>
                    </div>
                </div>

                <!-- Non-Cash Info Section -->
                <div id="non-cash-section" class="hidden text-center p-4 bg-slate-100 rounded-2xl border-2 border-slate-900">
                    <img id="qris-demo-img" src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=AICA-PUNYA-RASA-PAYMENT" alt="QRIS" class="mx-auto rounded-lg border-2 border-slate-900 mb-2 w-32 h-32">
                    <p class="text-xs font-bold text-slate-700">Tunjukkan QRIS di atas kepada pelanggan atau pastikan transfer telah berhasil.</p>
                </div>
            </div>

            <div class="p-4 bg-slate-50 border-t-4 border-slate-900">
                <button onclick="processTransaction()" class="w-full pop-btn bg-[#FF007A] text-white py-3 rounded-xl font-extrabold text-lg flex justify-center items-center gap-2">
                    <i data-lucide="printer" class="w-6 h-6"></i> Selesaikan & Cetak Struk
                </button>
            </div>
        </div>
    </div>

    <!-- ================= MODAL 2: STRUK CETAK ================= -->
    <div id="modal-receipt" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl border-4 border-slate-900 pop-card w-full max-w-sm overflow-hidden flex flex-col">
            
            <div class="p-4 border-b-2 border-slate-200 flex justify-between items-center bg-emerald-400">
                <h3 class="pop-font text-lg font-black text-slate-900">Pembayaran Berhasil!</h3>
                <button onclick="closeModal('modal-receipt')" class="text-slate-900 hover:text-red-600 font-bold text-lg">✕</button>
            </div>

            <!-- Printable Receipt Content -->
            <div id="printable-receipt" class="p-5 font-mono text-xs text-slate-800 space-y-3 bg-white">
                <div class="text-center border-b-2 border-dashed border-slate-400 pb-3">
                    <h2 class="font-extrabold text-base text-slate-900 uppercase">AICA PUNYA RASA</h2>
                    <p>Catering Makan Rumahan</p>
                    <p>Jl. Rasa Nusantara No. 88</p>
                    <p>Telp/WA: 0812-3456-7890</p>
                </div>

                <div class="space-y-1 text-[11px]">
                    <div class="flex justify-between">
                        <span>No. Tx:</span>
                        <span id="rcpt-id" class="font-bold">#000000</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Tanggal:</span>
                        <span id="rcpt-date">00/00/0000</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Pelanggan:</span>
                        <span id="rcpt-customer">Umum</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Layanan:</span>
                        <span id="rcpt-type">Takeaway</span>
                    </div>
                </div>

                <div class="border-t-2 border-b-2 border-dashed border-slate-400 py-2 space-y-1.5" id="rcpt-items-list">
                    <!-- Dynamic receipt items -->
                </div>

                <div class="space-y-1 text-right font-bold">
                    <div class="flex justify-between">
                        <span>Subtotal:</span>
                        <span id="rcpt-subtotal">Rp 0</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Metode:</span>
                        <span id="rcpt-method">CASH</span>
                    </div>
                    <div class="flex justify-between text-sm font-black text-slate-900 pt-1 border-t border-slate-300">
                        <span>Total:</span>
                        <span id="rcpt-total">Rp 0</span>
                    </div>
                    <div class="flex justify-between text-slate-600">
                        <span>Bayar:</span>
                        <span id="rcpt-pay">Rp 0</span>
                    </div>
                    <div class="flex justify-between text-slate-600">
                        <span>Kembali:</span>
                        <span id="rcpt-change">Rp 0</span>
                    </div>
                </div>

                <div class="text-center border-t-2 border-dashed border-slate-400 pt-3 text-[10px] space-y-1">
                    <p class="font-bold">Terima Kasih Atas Pesanannya!</p>
                    <p>Sajian Rumahan Penuh Cita Rasa</p>
                </div>
            </div>

            <!-- Receipt Modal Footer Buttons -->
            <div class="p-4 bg-slate-50 border-t-2 border-slate-200 flex gap-2 no-print">
                <button onclick="window.print()" class="flex-1 pop-btn bg-[#00E5FF] text-slate-900 py-2 rounded-xl font-bold text-sm flex justify-center items-center gap-1">
                    <i data-lucide="printer" class="w-4 h-4"></i> Cetak Struk
                </button>
                <button onclick="finishOrder()" class="flex-1 pop-btn bg-[#10B981] text-white py-2 rounded-xl font-bold text-sm">
                    Selesai / Baru
                </button>
            </div>
        </div>
    </div>

    <!-- ================= MODAL 3: TAMBAH / EDIT MENU ================= -->
    <div id="modal-menu-form" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-3xl border-4 border-slate-900 pop-card w-full max-w-md overflow-hidden">
            <div class="bg-[#00E5FF] p-4 border-b-4 border-slate-900 flex justify-between items-center">
                <h3 id="form-menu-title" class="pop-font text-2xl font-black text-slate-900">Tambah Menu Baru</h3>
                <button onclick="closeModal('modal-menu-form')" class="text-slate-900 font-black text-xl">✕</button>
            </div>

            <form id="menu-form" onsubmit="saveMenuForm(event)" class="p-5 space-y-3">
                <input type="hidden" id="edit-menu-id">
                
                <div>
                    <label class="font-bold text-slate-800 text-xs block mb-1">Nama Menu Catering:</label>
                    <input type="text" id="menu-name-input" required placeholder="Contoh: Paket Nasi Ayam Bakar" 
                        class="w-full px-3 py-2 rounded-xl border-2 border-slate-900 font-semibold focus:outline-none focus:ring-2 focus:ring-[#FF007A]">
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="font-bold text-slate-800 text-xs block mb-1">Kategori:</label>
                        <select id="menu-category-input" required class="w-full px-3 py-2 rounded-xl border-2 border-slate-900 font-semibold bg-white focus:outline-none">
                            <option value="Paket Hemat">Paket Hemat</option>
                            <option value="Lauk Pauk">Lauk Pauk</option>
                            <option value="Sayuran">Sayuran</option>
                            <option value="Minuman">Minuman</option>
                            <option value="Snack Box">Snack Box</option>
                        </select>
                    </div>
                    <div>
                        <label class="font-bold text-slate-800 text-xs block mb-1">Stok Porsi:</label>
                        <input type="number" id="menu-stock-input" required min="0" placeholder="50" 
                            class="w-full px-3 py-2 rounded-xl border-2 border-slate-900 font-semibold focus:outline-none">
                    </div>
                </div>

                <div>
                    <label class="font-bold text-slate-800 text-xs block mb-1">Harga (Rp):</label>
                    <input type="number" id="menu-price-input" required min="0" placeholder="25000" 
                        class="w-full px-3 py-2 rounded-xl border-2 border-slate-900 font-semibold focus:outline-none">
                </div>

                <div>
                    <label class="font-bold text-slate-800 text-xs block mb-1">URL Gambar / Foto Menu:</label>
                    <input type="url" id="menu-image-input" placeholder="https://images.unsplash.com/..." 
                        class="w-full px-3 py-2 rounded-xl border-2 border-slate-900 font-semibold focus:outline-none text-xs">
                    <span class="text-[10px] text-slate-500 mt-0.5 block">*Biarkan kosong untuk gambar default makanan.</span>
                </div>

                <div class="pt-3 border-t-2 border-slate-200 flex justify-end gap-2">
                    <button type="button" onclick="closeModal('modal-menu-form')" class="pop-btn bg-slate-200 text-slate-800 px-4 py-2 rounded-xl text-sm font-bold">Batal</button>
                    <button type="submit" class="pop-btn bg-[#FF007A] text-white px-5 py-2 rounded-xl text-sm font-bold">Simpan Menu</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Default Master Data Catering
        const DEFAULT_MENUS = [
            { id: 1, name: 'Nasi Liwet Komplit', category: 'Paket Hemat', price: 28000, stock: 45, image: 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400&q=80' },
            { id: 2, name: 'Ayam Goreng Lengkuas', category: 'Lauk Pauk', price: 18000, stock: 60, image: 'https://images.unsplash.com/photo-1626645738196-c2a7c87a8f58?w=400&q=80' },
            { id: 3, name: 'Rendang Daging Sapi', category: 'Lauk Pauk', price: 25000, stock: 30, image: 'https://images.unsplash.com/photo-1544025162-d76694265947?w=400&q=80' },
            { id: 4, name: 'Sayur Asem Rumahan', category: 'Sayuran', price: 10000, stock: 40, image: 'https://images.unsplash.com/photo-1540420773420-3366772f4999?w=400&q=80' },
            { id: 5, name: 'Tumis Buncis Baso', category: 'Sayuran', price: 12000, stock: 35, image: 'https://images.unsplash.com/photo-1512621776951-a57141f2eefd?w=400&q=80' },
            { id: 6, name: 'Es Teh Manis Jumbo', category: 'Minuman', price: 5000, stock: 100, image: 'https://images.unsplash.com/photo-1556679343-c7306c1976bc?w=400&q=80' },
            { id: 7, name: 'Es Jeruk Peras', category: 'Minuman', price: 7000, stock: 80, image: 'https://images.unsplash.com/photo-1613478223719-2ab802602423?w=400&q=80' },
            { id: 8, name: 'Snack Box Manis & Gurih', category: 'Snack Box', price: 15000, stock: 50, image: 'https://images.unsplash.com/photo-1509440159596-0249088772ff?w=400&q=80' }
        ];

        // State Management
        let menus = [];
        let cart = [];
        let salesHistory = [];
        let activeCategory = 'Semua';
        let selectedPayMethod = 'CASH';
        let currentTransaction = null;

        // Init App
        window.onload = function() {
            loadLocalStorageData();
            renderCategories();
            renderMenuList();
            renderCart();
            renderMenuTable();
            renderMaintenanceStats();
            lucide.createIcons();
        };

        // Local Storage Handlers
        function loadLocalStorageData() {
            const savedMenus = localStorage.getItem('aica_menus');
            menus = savedMenus ? JSON.parse(savedMenus) : [...DEFAULT_MENUS];

            const savedSales = localStorage.getItem('aica_sales');
            salesHistory = savedSales ? JSON.parse(savedSales) : [];
        }

        function saveMenusToStorage() {
            localStorage.setItem('aica_menus', JSON.stringify(menus));
        }

        function saveSalesToStorage() {
            localStorage.setItem('aica_sales', JSON.stringify(salesHistory));
        }

        // Navigation Switcher
        function switchTab(tab) {
            document.getElementById('section-pos').classList.add('hidden');
            document.getElementById('section-menu').classList.add('hidden');
            document.getElementById('section-maintenance').classList.add('hidden');

            document.getElementById('tab-pos').className = "pop-btn bg-white text-slate-900 px-4 py-2 rounded-xl flex items-center gap-2 text-sm md:text-base";
            document.getElementById('tab-menu').className = "pop-btn bg-white text-slate-900 px-4 py-2 rounded-xl flex items-center gap-2 text-sm md:text-base";
            document.getElementById('tab-maintenance').className = "pop-btn bg-white text-slate-900 px-4 py-2 rounded-xl flex items-center gap-2 text-sm md:text-base";

            if (tab === 'pos') {
                document.getElementById('section-pos').classList.remove('hidden');
                document.getElementById('tab-pos').className = "pop-btn bg-[#00E5FF] text-slate-900 px-4 py-2 rounded-xl flex items-center gap-2 text-sm md:text-base";
            } else if (tab === 'menu') {
                document.getElementById('section-menu').classList.remove('hidden');
                document.getElementById('tab-menu').className = "pop-btn bg-[#00E5FF] text-slate-900 px-4 py-2 rounded-xl flex items-center gap-2 text-sm md:text-base";
                renderMenuTable();
            } else if (tab === 'maintenance') {
                document.getElementById('section-maintenance').classList.remove('hidden');
                document.getElementById('tab-maintenance').className = "pop-btn bg-[#00E5FF] text-slate-900 px-4 py-2 rounded-xl flex items-center gap-2 text-sm md:text-base";
                renderMaintenanceStats();
            }
        }

        // Render Categories
        function renderCategories() {
            const categories = ['Semua', 'Paket Hemat', 'Lauk Pauk', 'Sayuran', 'Minuman', 'Snack Box'];
            const container = document.getElementById('category-filters');
            container.innerHTML = categories.map(cat => `
                <button onclick="filterCategory('${cat}')" 
                    class="pop-badge px-3 py-1.5 rounded-xl font-extrabold text-xs whitespace-nowrap transition-all ${activeCategory === cat ? 'bg-[#FFD700] text-slate-900 scale-105' : 'bg-white text-slate-800 hover:bg-slate-100'}">
                    ${cat}
                </button>
            `).join('');
        }

        function filterCategory(cat) {
            activeCategory = cat;
            renderCategories();
            renderMenuList();
        }

        // Render POS Menu Grid
        function renderMenuList() {
            const searchQuery = document.getElementById('search-input').value.toLowerCase();
            const grid = document.getElementById('menu-grid');

            const filtered = menus.filter(m => {
                const matchesCat = activeCategory === 'Semua' || m.category === activeCategory;
                const matchesSearch = m.name.toLowerCase().includes(searchQuery);
                return matchesCat && matchesSearch;
            });

            if (filtered.length === 0) {
                grid.innerHTML = `
                    <div class="col-span-full text-center py-12 text-slate-600">
                        <i data-lucide="utensils-crossed" class="w-12 h-12 mx-auto mb-2 opacity-50"></i>
                        <p class="font-bold">Menu catering tidak ditemukan...</p>
                    </div>
                `;
                lucide.createIcons();
                return;
            }

            grid.innerHTML = filtered.map(item => `
                <div class="bg-white rounded-2xl border-3 border-slate-900 pop-card overflow-hidden flex flex-col justify-between p-2.5">
                    <div>
                        <div class="relative h-28 w-full rounded-xl overflow-hidden border-2 border-slate-900 mb-2 bg-amber-100">
                            <img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover" onerror="this.src='https://placehold.co/400x300/FFD700/1E293B?text=AICA+PUNYA+RASA'">
                            <span class="absolute top-1 right-1 bg-[#FFD700] text-slate-900 text-[10px] font-extrabold px-2 py-0.5 rounded-md border border-slate-900 pop-badge">
                                Stok: ${item.stock}
                            </span>
                        </div>
                        <span class="text-[10px] font-bold text-[#FF007A] uppercase tracking-wider block">${item.category}</span>
                        <h3 class="font-extrabold text-slate-900 text-xs md:text-sm leading-snug line-clamp-2">${item.name}</h3>
                    </div>
                    
                    <div class="mt-2 pt-2 border-t-2 border-slate-100 flex justify-between items-center">
                        <span class="pop-font text-xs md:text-sm font-black text-slate-900">Rp ${item.price.toLocaleString('id-ID')}</span>
                        <button onclick="addToCart(${item.id})" ${item.stock <= 0 ? 'disabled' : ''} 
                            class="pop-btn bg-[#00E5FF] text-slate-900 p-1.5 rounded-lg disabled:bg-slate-300 disabled:border-slate-400">
                            <i data-lucide="plus" class="w-4 h-4 stroke-[3]"></i>
                        </button>
                    </div>
                </div>
            `).join('');
            lucide.createIcons();
        }

        // Cart Actions
        function addToCart(menuId) {
            const menu = menus.find(m => m.id === menuId);
            if (!menu || menu.stock <= 0) return;

            const existing = cart.find(c => c.id === menuId);
            if (existing) {
                if (existing.qty < menu.stock) {
                    existing.qty++;
                } else {
                    alert('Stok tidak mencukupi!');
                }
            } else {
                cart.push({ ...menu, qty: 1 });
            }
            renderCart();
        }

        function updateCartQty(menuId, change) {
            const item = cart.find(c => c.id === menuId);
            const menu = menus.find(m => m.id === menuId);
            if (!item) return;

            item.qty += change;
            if (item.qty > menu.stock) {
                item.qty = menu.stock;
                alert('Mencapai batas stok tersedia!');
            }

            if (item.qty <= 0) {
                cart = cart.filter(c => c.id !== menuId);
            }
            renderCart();
        }

        function clearCart() {
            cart = [];
            renderCart();
        }

        function renderCart() {
            const container = document.getElementById('cart-items');
            if (cart.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-10 text-slate-400 space-y-2">
                        <i data-lucide="shopping-cart" class="w-10 h-10 mx-auto opacity-40"></i>
                        <p class="font-bold text-xs">Belum ada item di keranjang.</p>
                    </div>
                `;
                document.getElementById('cart-subtotal').innerText = 'Rp 0';
                document.getElementById('cart-tax').innerText = 'Rp 0';
                document.getElementById('cart-total').innerText = 'Rp 0';
                document.getElementById('btn-pay').disabled = true;
                lucide.createIcons();
                return;
            }

            let subtotal = 0;
            container.innerHTML = cart.map(item => {
                const itemTotal = item.price * item.qty;
                subtotal += itemTotal;
                return `
                    <div class="flex items-center justify-between bg-slate-50 p-2.5 rounded-xl border-2 border-slate-900 pop-badge">
                        <div class="flex-1 pr-2">
                            <h4 class="font-extrabold text-xs text-slate-900 leading-tight">${item.name}</h4>
                            <span class="text-[11px] font-bold text-slate-600">Rp ${item.price.toLocaleString('id-ID')}</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <button onclick="updateCartQty(${item.id}, -1)" class="w-6 h-6 rounded-md bg-rose-400 border border-slate-900 flex items-center justify-center font-bold text-white text-xs">-</button>
                            <span class="font-black text-xs w-5 text-center">${item.qty}</span>
                            <button onclick="updateCartQty(${item.id}, 1)" class="w-6 h-6 rounded-md bg-emerald-400 border border-slate-900 flex items-center justify-center font-bold text-slate-900 text-xs">+</button>
                        </div>
                        <div class="w-20 text-right font-black text-xs text-slate-900 ml-2">
                            Rp ${itemTotal.toLocaleString('id-ID')}
                        </div>
                    </div>
                `;
            }).join('');

            const tax = 0; // Tax configuration
            const total = subtotal + tax;

            document.getElementById('cart-subtotal').innerText = `Rp ${subtotal.toLocaleString('id-ID')}`;
            document.getElementById('cart-tax').innerText = `Rp ${tax.toLocaleString('id-ID')}`;
            document.getElementById('cart-total').innerText = `Rp ${total.toLocaleString('id-ID')}`;
            document.getElementById('btn-pay').disabled = false;

            lucide.createIcons();
        }

        // Payment Modal & Logic
        function openPaymentModal() {
            if (cart.length === 0) return;
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            
            document.getElementById('pay-total-amount').innerText = `Rp ${subtotal.toLocaleString('id-ID')}`;
            document.getElementById('cash-given-input').value = '';
            document.getElementById('cash-change-display').innerText = 'Rp 0';
            
            // Generate Quick Cash Options
            const quickCashContainer = document.getElementById('quick-cash-container');
            const quickNominals = [subtotal, Math.ceil(subtotal/10000)*10000, Math.ceil(subtotal/50000)*50000, 100000].filter((v, i, a) => a.indexOf(v) === i && v >= subtotal);
            quickCashContainer.innerHTML = quickNominals.map(nom => `
                <button type="button" onclick="setCashGiven(${nom})" class="pop-btn bg-yellow-200 text-slate-900 py-1 px-2 rounded-lg text-xs font-bold">
                    ${nom === subtotal ? 'Uang Pas' : 'Rp ' + (nom/1000) + 'k'}
                </button>
            `).join('');

            selectPayMethod('CASH');
            document.getElementById('modal-payment').classList.remove('hidden');
        }

        function selectPayMethod(method) {
            selectedPayMethod = method;
            const cashBtn = document.getElementById('pay-method-cash');
            const qrisBtn = document.getElementById('pay-method-qris');
            const transferBtn = document.getElementById('pay-method-transfer');

            [cashBtn, qrisBtn, transferBtn].forEach(b => b.className = "pop-btn p-3 rounded-xl text-center bg-white text-slate-900 text-sm font-bold flex flex-col items-center justify-center gap-1");

            if (method === 'CASH') {
                cashBtn.className = "pop-btn p-3 rounded-xl text-center bg-[#00E5FF] text-slate-900 text-sm font-bold flex flex-col items-center justify-center gap-1";
                document.getElementById('cash-payment-section').classList.remove('hidden');
                document.getElementById('non-cash-section').classList.add('hidden');
            } else {
                const activeBtn = method === 'QRIS' ? qrisBtn : transferBtn;
                activeBtn.className = "pop-btn p-3 rounded-xl text-center bg-[#00E5FF] text-slate-900 text-sm font-bold flex flex-col items-center justify-center gap-1";
                document.getElementById('cash-payment-section').classList.add('hidden');
                document.getElementById('non-cash-section').classList.remove('hidden');
            }
        }

        function setCashGiven(amount) {
            document.getElementById('cash-given-input').value = amount;
            calculateChange();
        }

        function calculateChange() {
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            const cashGiven = parseFloat(document.getElementById('cash-given-input').value) || 0;
            const change = cashGiven - subtotal;
            
            const display = document.getElementById('cash-change-display');
            if (change >= 0) {
                display.innerText = `Rp ${change.toLocaleString('id-ID')}`;
                display.className = "pop-font text-2xl font-black text-emerald-600";
            } else {
                display.innerText = `Kurang Rp ${Math.abs(change).toLocaleString('id-ID')}`;
                display.className = "pop-font text-xl font-black text-rose-600";
            }
        }

        function processTransaction() {
            const subtotal = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            let cashGiven = parseFloat(document.getElementById('cash-given-input').value) || 0;

            if (selectedPayMethod === 'CASH' && cashGiven < subtotal) {
                alert('Uang yang dibayarkan masih kurang!');
                return;
            }

            if (selectedPayMethod !== 'CASH') {
                cashGiven = subtotal;
            }

            const change = cashGiven - subtotal;
            const customerName = document.getElementById('customer-name').value || 'Pelanggan Umum';
            const orderType = document.getElementById('order-type').value;

            // Deduct stock
            cart.forEach(cartItem => {
                const target = menus.find(m => m.id === cartItem.id);
                if (target) {
                    target.stock -= cartItem.qty;
                }
            });
            saveMenusToStorage();

            // Create Transaction Record
            currentTransaction = {
                id: 'AICA-' + Math.floor(100000 + Math.random() * 900000),
                date: new Date().toLocaleString('id-ID'),
                customer: customerName,
                orderType: orderType,
                items: [...cart],
                subtotal: subtotal,
                method: selectedPayMethod,
                cashGiven: cashGiven,
                change: change
            };

            salesHistory.unshift(currentTransaction);
            saveSalesToStorage();

            closeModal('modal-payment');
            showReceiptModal();
            renderMenuList();
        }

        // Receipt Modal
        function showReceiptModal() {
            if (!currentTransaction) return;

            document.getElementById('rcpt-id').innerText = currentTransaction.id;
            document.getElementById('rcpt-date').innerText = currentTransaction.date;
            document.getElementById('rcpt-customer').innerText = currentTransaction.customer;
            document.getElementById('rcpt-type').innerText = currentTransaction.orderType;
            document.getElementById('rcpt-method').innerText = currentTransaction.method;

            const itemsContainer = document.getElementById('rcpt-items-list');
            itemsContainer.innerHTML = currentTransaction.items.map(item => `
                <div class="flex justify-between">
                    <div>
                        <div>${item.name}</div>
                        <div class="text-[9px] text-slate-500">${item.qty} x Rp ${item.price.toLocaleString('id-ID')}</div>
                    </div>
                    <div class="font-bold">Rp ${(item.qty * item.price).toLocaleString('id-ID')}</div>
                </div>
            `).join('');

            document.getElementById('rcpt-subtotal').innerText = `Rp ${currentTransaction.subtotal.toLocaleString('id-ID')}`;
            document.getElementById('rcpt-total').innerText = `Rp ${currentTransaction.subtotal.toLocaleString('id-ID')}`;
            document.getElementById('rcpt-pay').innerText = `Rp ${currentTransaction.cashGiven.toLocaleString('id-ID')}`;
            document.getElementById('rcpt-change').innerText = `Rp ${currentTransaction.change.toLocaleString('id-ID')}`;

            document.getElementById('modal-receipt').classList.remove('hidden');
        }

        function finishOrder() {
            cart = [];
            currentTransaction = null;
            document.getElementById('customer-name').value = 'Pelanggan Umum';
            renderCart();
            closeModal('modal-receipt');
        }

        // Menu CRUD Logic
        function renderMenuTable() {
            const tbody = document.getElementById('menu-table-body');
            tbody.innerHTML = menus.map(m => `
                <tr class="hover:bg-slate-50">
                    <td class="p-4">
                        <img src="${m.image}" alt="${m.name}" class="w-12 h-12 rounded-lg object-cover border-2 border-slate-900" onerror="this.src='https://placehold.co/100x100/FFD700/1E293B?text=AICA'">
                    </td>
                    <td class="p-4 font-bold text-slate-900">${m.name}</td>
                    <td class="p-4">
                        <span class="bg-yellow-200 text-slate-900 px-2 py-1 rounded-md border border-slate-900 text-xs font-bold pop-badge">${m.category}</span>
                    </td>
                    <td class="p-4 font-extrabold text-[#FF007A]">Rp ${m.price.toLocaleString('id-ID')}</td>
                    <td class="p-4">
                        <span class="font-bold ${m.stock < 10 ? 'text-rose-600' : 'text-slate-800'}">${m.stock} Porsi</span>
                    </td>
                    <td class="p-4 text-center">
                        <div class="flex justify-center gap-2">
                            <button onclick="openEditMenuModal(${m.id})" class="pop-btn bg-[#00E5FF] text-slate-900 p-2 rounded-lg">
                                <i data-lucide="edit-3" class="w-4 h-4"></i>
                            </button>
                            <button onclick="deleteMenu(${m.id})" class="pop-btn bg-red-500 text-white p-2 rounded-lg">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `).join('');
            lucide.createIcons();
        }

        function openAddMenuModal() {
            document.getElementById('form-menu-title').innerText = 'Tambah Menu Baru';
            document.getElementById('edit-menu-id').value = '';
            document.getElementById('menu-name-input').value = '';
            document.getElementById('menu-category-input').value = 'Paket Hemat';
            document.getElementById('menu-price-input').value = '';
            document.getElementById('menu-stock-input').value = '';
            document.getElementById('menu-image-input').value = '';
            document.getElementById('modal-menu-form').classList.remove('hidden');
        }

        function openEditMenuModal(id) {
            const menu = menus.find(m => m.id === id);
            if (!menu) return;

            document.getElementById('form-menu-title').innerText = 'Edit Menu Catering';
            document.getElementById('edit-menu-id').value = menu.id;
            document.getElementById('menu-name-input').value = menu.name;
            document.getElementById('menu-category-input').value = menu.category;
            document.getElementById('menu-price-input').value = menu.price;
            document.getElementById('menu-stock-input').value = menu.stock;
            document.getElementById('menu-image-input').value = menu.image;
            document.getElementById('modal-menu-form').classList.remove('hidden');
        }

        function saveMenuForm(e) {
            e.preventDefault();
            const id = document.getElementById('edit-menu-id').value;
            const name = document.getElementById('menu-name-input').value;
            const category = document.getElementById('menu-category-input').value;
            const price = parseFloat(document.getElementById('menu-price-input').value);
            const stock = parseInt(document.getElementById('menu-stock-input').value);
            let image = document.getElementById('menu-image-input').value;

            if (!image) {
                image = 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400&q=80';
            }

            if (id) {
                // Edit
                const index = menus.findIndex(m => m.id == id);
                if (index !== -1) {
                    menus[index] = { ...menus[index], name, category, price, stock, image };
                }
            } else {
                // Add
                const newMenu = {
                    id: Date.now(),
                    name,
                    category,
                    price,
                    stock,
                    image
                };
                menus.push(newMenu);
            }

            saveMenusToStorage();
            closeModal('modal-menu-form');
            renderMenuTable();
            renderMenuList();
        }

        function deleteMenu(id) {
            if (confirm('Apakah anda yakin ingin menghapus menu ini?')) {
                menus = menus.filter(m => m.id !== id);
                saveMenusToStorage();
                renderMenuTable();
                renderMenuList();
            }
        }

        // Maintenance & System Stats
        function renderMaintenanceStats() {
            const totalTx = salesHistory.length;
            const totalRev = salesHistory.reduce((sum, tx) => sum + tx.subtotal, 0);
            const totalItems = salesHistory.reduce((sum, tx) => sum + tx.items.reduce((iSum, i) => iSum + i.qty, 0), 0);

            document.getElementById('stat-total-tx').innerText = totalTx;
            document.getElementById('stat-total-rev').innerText = `Rp ${totalRev.toLocaleString('id-ID')}`;
            document.getElementById('stat-total-items').innerText = totalItems;

            const tbody = document.getElementById('sales-history-body');
            tbody.innerHTML = salesHistory.map(tx => `
                <tr>
                    <td class="p-2 font-bold">${tx.id}</td>
                    <td class="p-2">${tx.date}</td>
                    <td class="p-2">${tx.customer} (${tx.orderType})</td>
                    <td class="p-2"><span class="bg-blue-100 px-1.5 py-0.5 rounded border border-slate-900 font-bold text-[10px]">${tx.method}</span></td>
                    <td class="p-2 font-extrabold text-[#FF007A]">Rp ${tx.subtotal.toLocaleString('id-ID')}</td>
                </tr>
            `).join('');
        }

        function exportData() {
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify({ menus, salesHistory }));
            const downloadAnchor = document.createElement('a');
            downloadAnchor.setAttribute("href", dataStr);
            downloadAnchor.setAttribute("download", `AICA_CATERING_BACKUP_${new Date().toISOString().slice(0,10)}.json`);
            document.body.appendChild(downloadAnchor);
            downloadAnchor.click();
            downloadAnchor.remove();
        }

        function importData(event) {
            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const data = JSON.parse(e.target.result);
                    if (data.menus) menus = data.menus;
                    if (data.salesHistory) salesHistory = data.salesHistory;
                    saveMenusToStorage();
                    saveSalesToStorage();
                    alert('Data berhasil dipulihkan!');
                    location.reload();
                } catch (err) {
                    alert('Format file backup tidak valid!');
                }
            };
            reader.readAsText(event.target.files[0]);
        }

        function resetDefaultMenu() {
            if (confirm('Kembalikan menu ke daftar standar bawaan? Menu tambahan anda mungkin akan hilang.')) {
                menus = [...DEFAULT_MENUS];
                saveMenusToStorage();
                renderMenuList();
                renderMenuTable();
                alert('Menu berhasil direset!');
            }
        }

        function clearSalesHistory() {
            if (confirm('Hapus seluruh riwayat penjualan? Tindakan ini tidak dapat dibatalkan.')) {
                salesHistory = [];
                saveSalesToStorage();
                renderMaintenanceStats();
                alert('Riwayat penjualan berhasil dibersihkan!');
            }
        }

        function exportSalesCSV() {
            if (salesHistory.length === 0) {
                alert('Belum ada transaksi untuk diekspor!');
                return;
            }
            let csvContent = "data:text/csv;charset=utf-8,ID Transaksi,Tanggal,Pelanggan,Metode,Total\n";
            salesHistory.forEach(tx => {
                csvContent += `${tx.id},"${tx.date}","${tx.customer}",${tx.method},${tx.subtotal}\n`;
            });

            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Laporan_Penjualan_AICA_${new Date().toISOString().slice(0,10)}.csv`);
            document.body.appendChild(link);
            link.click();
            link.remove();
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }
    </script>
</body>
</html>
